{
  "context": {
    "fileName": "AGENTS.md"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "mcpServers": {
    "figma": {
      "httpUrl": "https://mcp.figma.com/mcp"
    },
    "chrome-devtools": {
      "command": "/opt/homebrew/bin/mise",
      "args": [
        "x",
        "--",
        "chrome-devtools-mcp",
        "--categoryExtensions",
        "--memoryDebugging"
      ]
    }
  },
  "ui": {
    "theme": "Default Light"
  }
}